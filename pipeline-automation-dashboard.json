    {
      "parameters": {
        "jsCode": "const input = $input.first()?.json ?? {};\nconst body = input.body ?? input;\n\nreturn [\n  {\n    json: {\n      config: {\n        companyName: body.companyName || 'ABM Solutions Demo',\n        demoMode: body.demoMode !== false\n      },\n      payload: body\n    }\n  }\n];"
      },
      "id": "fa776ca9-d150-4de8-85ba-d2eac701baeb",
      "name": "Load Configuration",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        480,
        352
      ]
    },
    {
      "parameters": {
        "jsCode": "\nconst root=$input.first().json,p=root.payload||{};\nconst opportunities=p.opportunities||[\n{name:'Northstar',stage:'Proposal',amount:18000,probability:.65,daysInStage:6},\n{name:'Acme',stage:'Qualified',amount:9000,probability:.35,daysInStage:14},\n{name:'Vertex',stage:'Negotiation',amount:24000,probability:.8,daysInStage:3},\n{name:'Nova',stage:'Closed Won',amount:12000,probability:1,daysInStage:1}\n];\nreturn [{json:{...root,opportunities}}];\n"
      },
      "id": "2f50106d-8952-419d-89c1-5a14c5b25b24",
      "name": "Create Demo Input",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        720,
        352
      ]
    },
    {
      "parameters": {
        "jsCode": "\nconst d=$input.first().json,ops=d.opportunities;\nconst byStage={}; let total=0,weighted=0,won=0;\nfor(const o of ops){byStage[o.stage]=(byStage[o.stage]||0)+1;total+=Number(o.amount||0);weighted+=Number(o.amount||0)*Number(o.probability||0);if(o.stage==='Closed Won')won+=Number(o.amount||0);}\nconst stalled=ops.filter(o=>o.daysInStage>=10&&o.stage!=='Closed Won'&&o.stage!=='Closed Lost');\nreturn [{json:{...d,result:{opportunityCount:ops.length,totalPipeline:total,weightedForecast:Math.round(weighted),closedWonRevenue:won,stageDistribution:byStage,stalledDeals:stalled,generatedAt:new Date().toISOString()}}}];\n"
      },
      "id": "2bfcffd9-d3ad-4d10-bb02-1d6e0019260b",
      "name": "Calculate Pipeline KPIs",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        976,
        352
      ]
    },
    {
      "parameters": {
        "jsCode": "\nconst d=$input.first().json;\nreturn [{json:{success:true,demoMode:d.config?.demoMode ?? true,workflow:$workflow.name,result:d.result || d,completedAt:new Date().toISOString()}}];\n"
      },
      "id": "eed4881f-273b-4e27-a171-94b216e7648f",
